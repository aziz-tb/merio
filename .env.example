# Merio compose environment template.
# Copy to .env and fill secrets locally; never commit real values.

MERIO_SECRETS_KEK=<openssl-rand-base64-32>
MERIO_SYSTEM_USER_PASSWORD=<initial-system-user-password>

POSTGRES_USER=merio
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=merio
TEMPORAL_DB_PASSWORD=<temporal-database-password>

# exec-runner shared token. Use the same value the old host service had in
# /etc/exec-runner.env when migrating the VPS.
EXEC_RUNNER_TOKEN=<openssl-rand-hex-32>

AZURE_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Linux/KVM containerized exec-runner. On the VPS, set:
#   KVM_GID=$(getent group kvm | cut -d: -f3)
KVM_GID=109
EXEC_WARM_POOL_PYTHON=5
EXEC_WARM_POOL_JS=0
EXEC_WARM_POOL_RAW=0
EXEC_VM_MEMORY=256
EXEC_TIMEOUT=60
EXEC_LOG_LEVEL=INFO

# Compose forwards these into MERIO_EXEC__* settings.
# VPS Docker mode:
SANDBOX_URL=http://exec-runner:8090
PLATFORM_BASE_URL=http://merio_app:9000

# Mac dev mode keeps exec-runner on the host via uv. Use dev-appropriate
# overrides instead, for example:
# SANDBOX_URL=http://host.docker.internal:8090
# PLATFORM_BASE_URL=http://<host-lan-ip>:9000

# Resource overcommit ratios for exec-sandbox. Defaults are fine for most
# setups; tune when scaling concurrency on smaller hosts.
# CPU_OVERCOMMIT_RATIO=2.0
# MEMORY_OVERCOMMIT_RATIO=5.0
